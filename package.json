{
  "name": "melonenport",
  "productName": "Melonenport",
  "version": "1.0.3",
  "description": "Wandelt GTA5-Mods-Fahrzeuge und Flugzeuge in FiveM-Resources um",
  "author": "DevWasserMelone",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "release": "electron-builder --win --publish always"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "electron-updater": "^6.3.9",
    "node-unrar-js": "^2.0.2"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "de.devwassermelone.melonenport",
    "productName": "Melonenport",
    "artifactName": "Melonenport-Setup-${version}.${ext}",
    "files": ["electron/**", "launcher/**", "app/**", "build/icon.png", "package.json"],
    "asarUnpack": ["node_modules/7zip-bin/**", "node_modules/node-unrar-js/**"],
    "directories": { "buildResources": "build", "output": "dist" },
    "win": { "target": "nsis", "icon": "build/icon.png" },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "Melonenport"
    },
    "publish": [{ "provider": "github", "owner": "DevWasserMelone", "repo": "Melonenport", "releaseType": "release" }]
  }
}
